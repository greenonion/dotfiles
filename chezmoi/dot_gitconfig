[user]
	name = Nikos Fertakis
	email = nikos.fertakis@gmail.com
[alias]
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	ci = commit
	co = checkout
	g = grep
[init]
	defaultBranch = main
[pull]
	ff = only
[rerere]
	enabled = true
[push]
	default = simple
[grep]
	lineNumber = true
[rebase]
	autosquash = true
[fetch]
	prune = true
[status]
	showUntrackedFiles = all
